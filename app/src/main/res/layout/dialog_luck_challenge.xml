<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingBottom="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_anim2"
            android:layout_width="match_parent"
            android:layout_height="311dp"
            android:src="@drawable/ic_dialog_congratulate"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_sans"
            android:text="@string/fortune_challenge"
            android:textColor="#F5C91A"
            android:textStyle="bold"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="325dp"
            android:layout_marginTop="63dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_dialog_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_top_confetti"
            android:layout_width="140dp"
            android:layout_height="70dp"
            android:background="@drawable/ic_top_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_close"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_marginTop="28dp"
            android:src="@drawable/ic_dialog_close"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_progress" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_anim"
            android:layout_width="205dp"
            android:layout_height="204dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ic_review_anim"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_dialog_bg" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_reward_box"
            android:layout_width="139dp"
            android:layout_height="121dp"
            android:layout_marginTop="29dp"
            android:src="@drawable/ic_fetch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_dialog_bg" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_reward_value"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="@font/noto_sans_bold"
            android:textColor="#F5B71A"
            android:textSize="32sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_reward_box"
            tools:text="+R$ 4000" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_claim"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginHorizontal="28dp"
            android:layout_marginTop="29dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/shape_primary_r20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_anim_parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_money"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/redeem"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="36dp"
                android:layout_height="24dp"
                android:layout_marginStart="28dp"
                android:src="@drawable/ic_ad_tag"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_money"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/iv_anim_parent"
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_game_rate"
            app:layout_constraintTop_toBottomOf="@id/tv_reward_value">

        </FrameLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="23dp"
            android:src="@drawable/ic_selected_icon"
            app:layout_constraintLeft_toLeftOf="@id/iv_anim_parent"
            app:layout_constraintRight_toRightOf="@id/iv_anim_parent"
            app:layout_constraintTop_toTopOf="@id/iv_anim_parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_progress"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/ic_progress_get_money"
            android:paddingVertical="2dp"
            app:layout_constraintTop_toBottomOf="@id/iv_dialog_bg">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_sa"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginHorizontal="16dp"
                android:fontFamily="@font/noto_sans"
                android:gravity="center"
                android:text="@string/withdrawal_progress"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_pro"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:fontFamily="@font/noto_sans"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/tv_sa"
                app:layout_constraintEnd_toStartOf="@id/iv_pack"
                app:layout_constraintTop_toTopOf="@id/tv_sa"
                tools:text="R$ 100/R$ 200" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_view"
                android:layout_width="0dp"
                android:layout_height="11dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="12dp"
                android:indeterminate="false"
                app:indicatorColor="#F5B71A"
                app:indicatorTrackGapSize="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/iv_pack"
                app:layout_constraintStart_toStartOf="parent"
                app:trackColor="#858585"
                app:trackCornerRadius="17dp"
                app:trackThickness="11dp"
                tools:progress="80" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_pack"
                android:layout_width="45dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="6dp"
                android:src="@drawable/ic_nav_bill"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
