<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:layout_width="37dp"
        android:layout_height="37dp"
        android:layout_marginBottom="15dp"
        android:src="@drawable/ic_dialog_close"
        app:layout_constraintBottom_toTopOf="@id/iv_dialog_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />



    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="609dp"
        android:alpha="0.5"
        android:background="@drawable/shape_dia_r16_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/noto_sans"
        android:paddingHorizontal="35dp"
        android:text="@string/my_wallet"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="@id/iv_dialog_bg" />


    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_view"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginHorizontal="35dp"
        android:layout_marginTop="40dp"
        android:indeterminate="false"
        app:indicatorColor="#F5B71A"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_dialog_bg"
        app:trackColor="#483E5F"
        app:trackCornerRadius="17dp"
        app:trackThickness="20dp"
        tools:progress="80" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="35dp"
        android:layout_height="30.5dp"
        android:layout_marginHorizontal="24dp"
        android:src="@drawable/ic_pro_money"
        app:layout_constraintBottom_toBottomOf="@id/progress_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/progress_view" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_sans"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/progress_view"
        app:layout_constraintLeft_toLeftOf="@id/progress_view"
        app:layout_constraintRight_toRightOf="@id/progress_view"
        app:layout_constraintTop_toTopOf="@id/progress_view"
        tools:text="xxx/xxx" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_view">

        <include
            android:id="@+id/layout_task"
            layout="@layout/layout_task_child"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>