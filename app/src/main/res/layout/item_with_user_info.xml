<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="213dp"
    android:layout_height="56dp"
    android:layout_marginHorizontal="10dp"
    android:background="@drawable/shape_r7_21192e">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_money"
        android:layout_width="29.5dp"
        android:layout_height="24.5dp"
        android:layout_marginHorizontal="12.5dp"
        android:src="@drawable/ic_coin_low"
        app:layout_constraintBottom_toTopOf="@id/tv_money"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_sans"
        android:text="R$ 50"
        android:textColor="#7BC52E"
        android:textSize="8sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/iv_money"
        app:layout_constraintEnd_toEndOf="@id/iv_money"
        app:layout_constraintTop_toBottomOf="@id/iv_money" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_user_name"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginHorizontal="10dp"
        android:fontFamily="@font/noto_sans"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@id/tv_pay_type"
        app:layout_constraintStart_toEndOf="@id/iv_money"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="ab****cd" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_pay_type"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:fontFamily="@font/noto_sans"
        android:gravity="center"
        android:textColor="#B4A6BE"
        android:textSize="8sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_user_name"
        app:layout_constraintTop_toBottomOf="@id/tv_user_name"
        tools:text="arrived via [Paypal]" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_day"
        android:layout_width="46.5dp"
        android:layout_height="11.5dp"
        android:layout_margin="9dp"
        android:background="@drawable/shape_r31_b1a4c3"
        android:fontFamily="@font/noto_sans"
        android:gravity="center"
        android:textColor="#21192E"
        android:textSize="7sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2026.1.20" />

</androidx.constraintlayout.widget.ConstraintLayout>