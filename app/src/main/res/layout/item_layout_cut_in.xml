<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/shape_g1a0_12"
    android:paddingHorizontal="24dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_with_method"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:src="@drawable/ic_paypal_w"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_cut"
        android:layout_width="80dp"
        android:layout_height="24dp"
        android:layout_marginTop="13dp"
        android:background="@drawable/shape_dark_r20"
        android:backgroundTint="#2CB42C"
        android:gravity="center"
        android:text="@string/cut_in"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="24dp"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:rotation="20"
        android:src="@drawable/ic_ad_tag"
        app:layout_constraintBottom_toTopOf="@id/tv_cut"
        app:layout_constraintEnd_toEndOf="@id/tv_cut"
        app:layout_constraintTop_toTopOf="@id/tv_cut" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:fontFamily="@font/noto_sans"
        android:text="1000"
        android:textColor="#FFD000"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tv_cut"
        app:layout_constraintEnd_toStartOf="@id/tv_cut"
        app:layout_constraintTop_toTopOf="@id/tv_cut" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/task_info_get_money"
        android:textColor="#C6B6E5"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_cut" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_view"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="34dp"
        android:indeterminate="false"
        app:indicatorColor="#FFE600"
        app:indicatorTrackGapSize="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tips"
        app:trackColor="#858585"
        app:trackCornerRadius="6dp"
        app:trackThickness="6dp"
        tools:progress="70" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_cur_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:textColor="@color/white"
        android:textSize="8sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_add_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_add_progress"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress_view"
        tools:text="20%" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_add_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_sans"
        android:textColor="#FF9900"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_cur_progress"
        app:layout_constraintTop_toBottomOf="@id/progress_view"
        tools:text="+20%" />

</androidx.constraintlayout.widget.ConstraintLayout>