<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="10dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:fontFamily="@font/noto_sans"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:shadowColor="#FFDD00"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="15"
        android:text="@string/flip_card_title"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/layout_cards"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/layout_cards"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <!-- 外层：选中框包在内层 ic_card_bg 外缘；缩放/翻转作用在外层，内层内缩露出边框 -->
        <FrameLayout
            android:id="@+id/card_1"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:clickable="true"
            android:clipChildren="false"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_selected_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/ic_selected_bg"
                android:visibility="gone"
                tools:visibility="visible" />

            <FrameLayout
                android:id="@+id/card_inner_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/ic_card_bg"
                android:padding="6dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_card_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/flip_card_back_text"
                    android:textColor="#A45714"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/card_2"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:clipChildren="false"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_selected_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/ic_selected_bg"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/card_inner_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/ic_card_bg"
                android:padding="6dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_card_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/flip_card_back_text"
                    android:textColor="#A45714"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/card_3"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_weight="1"
            android:clickable="true"
            android:clipChildren="false"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_selected_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/ic_selected_bg"
                android:visibility="gone"
                tools:visibility="visible" />

            <FrameLayout
                android:id="@+id/card_inner_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/ic_card_bg"
                android:padding="6dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_card_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/flip_card_back_text"
                    android:textColor="#A45714"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_finger_anim"
        android:layout_width="58dp"
        android:layout_height="51dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="42dp"
        android:rotation="180"
        android:rotationX="180"
        android:src="@drawable/ic_first_guide_finger"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/layout_cards"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_next"
        android:layout_width="230dp"
        android:layout_height="48dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/shape_dark_r20"
        android:backgroundTint="#F5CF1A"
        android:gravity="center"
        android:text="@string/flip_card_next"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_cards" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:layout_width="37dp"
        android:layout_height="37dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_dialog_close"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_next" />

</androidx.constraintlayout.widget.ConstraintLayout>
