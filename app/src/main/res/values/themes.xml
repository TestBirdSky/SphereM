<resources>
    <!-- Base application theme. -->
    <style name="Theme.Sphere" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorAccent">@color/color_primary</item>
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:statusBarColor">@color/color_background</item>
    </style>

    <style name="TabLayoutStyle" parent="@style/Widget.Design.TabLayout">
        <item name="tabIndicator">@drawable/layer_tab_style</item>
        <item name="tabIndicatorColor">@color/color_primary</item>
        <item name="tabIndicatorGravity">center</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabTextColor">@color/white</item>
        <item name="tabTextAppearance">@style/TabTextStyle</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.AppCompat.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/noto_sans_semibold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TransparentMaterialDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="TaskInfoDialogTheme" parent="TransparentMaterialDialog">
        <item name="android:windowAnimationStyle">@style/TaskInfoDialogAnimation</item>
    </style>

    <style name="TaskInfoDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_task_info_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_task_info_exit</item>
    </style>

</resources>